{
  "name": "@jftrade/root",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.21.0",
  "version": "0.0.0",
  "scripts": {
    "audit:dependencies": "pnpm audit --audit-level=moderate",
    "dev:web": "pnpm --filter @jftrade/web run dev",
    "dev:docs": "pnpm --filter @jftrade/web run docs:dev",
    "dev:all": "node scripts/dev-all.mjs",
    "desktop:dev": "go tool wails3 dev -config ./build/config.yml -port 3003",
    "desktop:doctor": "go tool wails3 doctor",
    "desktop:build": "go tool wails3 build",
    "desktop:package": "go tool wails3 package",
    "prepare:desktop-dev": "go tool wails3 task prepare:dev",
    "build": "pnpm run generate:contracts && pnpm run build:web:generated && pnpm run generate:reference && pnpm run build:docs:generated && pnpm run build:backend",
    "build:web": "pnpm run generate:contracts && pnpm run build:web:generated",
    "build:web:generated": "pnpm --filter @jftrade/web run build",
    "build:web:report": "pnpm run build:web:generated && pnpm run check:web-bundle",
    "build:docs": "pnpm run generate:docs && pnpm run build:docs:generated",
    "build:docs:generated": "pnpm --filter @jftrade/web run docs:build",
    "build:backend": "go build -tags=embed_zoneinfo -o dist/jftrade-dev ./cmd/jftrade-api",
    "build:rust": "cargo build --workspace",
    "benchmark:rust:stage2": "node scripts/rust-migration/benchmark-readonly.mjs",
    "benchmark:rust:stage3": "node scripts/rust-migration/benchmark-backtest.mjs",
    "benchmark:rust:stage4": "node scripts/rust-migration/benchmark-stage4.mjs",
    "benchmark:rust:stage5": "node scripts/rust-migration/benchmark-stage5.mjs",
    "benchmark:rust:stage6": "node scripts/rust-migration/benchmark-stage6.mjs",
    "run:rust:stage3:owner": "node scripts/rust-migration/run-backtest-owner.mjs",
    "prepare:desktop-release": "node scripts/prepare-desktop-release.mjs",
    "build:frontend-assets": "pnpm run generate:docs && pnpm run build:frontend-assets:generated",
    "build:frontend-assets:generated": "node scripts/build-frontend-assets.mjs",
    "build:pineworker": "node scripts/build-pineworker-assets.mjs",
    "build:pineworker:dev": "node scripts/build-pineworker-dev.mjs",
    "build:marketdata-sidecar": "node scripts/build-marketdata-sidecar.mjs",
    "build:yfinance-sidecar": "pnpm run build:marketdata-sidecar",
    "smoke:marketdata-sidecar": "node scripts/smoke-marketdata-sidecar.mjs",
    "smoke:yfinance-sidecar": "pnpm run smoke:marketdata-sidecar",
    "dev:api:pineworker": "node scripts/dev-api-pineworker.mjs",
    "check:pinets-release": "node scripts/check-pinets-release.mjs",
    "check:arch-deps": "bash scripts/check-arch-deps.sh",
    "check:ai-context": "node scripts/check-ai-context.mjs",
    "check:go-file-length": "node scripts/check-go-file-length-budget.mjs",
    "check:generated": "node scripts/generate-contracts.mjs --check",
    "check:quick": "node scripts/test-affected.mjs --with-checks",
    "check:all": "node scripts/run-test-layer.mjs main",
    "check:actionlint": "go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.9",
    "check:diff": "node scripts/check-diff.mjs",
    "check:rust": "pnpm run check:rust:layout && pnpm run format:rust:check && pnpm run lint:rust && pnpm run test:rust && pnpm run test:rust:differential && pnpm run test:rust:backtest:differential && pnpm run test:rust:stage4:differential && pnpm run test:rust:stage5:differential && pnpm run test:rust:stage6:differential",
    "check:rust:layout": "node scripts/rust-migration/check-layout.mjs",
    "check:rust:policy": "cargo deny check",
    "test:pinets-release-check": "node scripts/check-pinets-release.test.mjs",
    "test:pineworker-asset-build": "node scripts/build-pineworker-assets.test.mjs",
    "test:pineworker-dev-build": "node scripts/build-pineworker-dev.test.mjs",
    "test:marketdata-sidecar-asset-build": "node scripts/build-marketdata-sidecar.test.mjs",
    "test:yfinance-sidecar-asset-build": "pnpm run test:marketdata-sidecar-asset-build",
    "test:marketdata-sidecar-smoke": "node --test scripts/smoke-marketdata-sidecar.test.mjs",
    "test:pinets-shadow-corpus": "go test ./pkg/backtest -run TestPinetsShadowCorpusReport -count=1 -v",
    "test:pine-structure-corpus": "go test ./pkg/strategy/pine -run '^TestSharedPineStructureCorpus' -count=1 && pnpm --filter @jftrade/web run test pineSharedStructureCorpus",
    "smoke:pinets-backtest": "node scripts/smoke-pinets-backtest.mjs",
    "lint:go": "go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.12.0 run --timeout=5m --build-tags=gtk3",
    "lint:go:errorlint": "node scripts/run-errorlint.mjs",
    "lint:rust": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "format:rust:check": "cargo fmt --all -- --check",
    "vet:go": "go vet ./...",
    "test:go": "go test ./... -count=1 -timeout 300s",
    "test:rust": "cargo test --workspace --all-targets",
    "test:rust:backtest:differential": "node scripts/rust-migration/check-backtest-differential.mjs",
    "test:rust:differential": "node scripts/rust-migration/check-differential.mjs",
    "test:rust:stage4:differential": "node scripts/rust-migration/check-stage4-differential.mjs",
    "test:rust:stage5:differential": "node scripts/rust-migration/check-stage5-differential.mjs",
    "test:rust:stage6:differential": "node scripts/rust-migration/check-stage6-differential.mjs",
    "test:servercore": "go test ./internal/app/apiserver/servercore -count=1 -timeout 120s",
    "test:web": "pnpm --filter @jftrade/web run test",
    "test:web:ci": "pnpm --filter @jftrade/web run test:ci",
    "test:web:watch": "pnpm --filter @jftrade/web run test:watch",
    "test:coverage": "pnpm run test:coverage:go && pnpm run test:coverage:web && pnpm run test:coverage:worker",
    "test:coverage:go": "node scripts/run-go-coverage.mjs",
    "test:coverage:web": "node scripts/run-web-coverage.mjs",
    "test:coverage:worker": "pnpm --filter @jftrade/pineworker run test:coverage",
    "test:pineworker": "pnpm --filter @jftrade/pineworker run test",
    "typecheck:web": "pnpm --filter @jftrade/web run typecheck",
    "typecheck:web-contracts": "pnpm --filter @jftrade/web run typecheck:contracts",
    "typecheck:pineworker": "pnpm --filter @jftrade/pineworker run typecheck",
    "generate:openapi": "go generate ./cmd/jftrade-api",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "generate:reference": "node scripts/generate-docs.mjs",
    "generate:docs": "pnpm run generate:contracts && pnpm run generate:reference",
    "generate:api-types": "node scripts/generate-api-types.mjs",
    "generate:wails-bindings": "go tool wails3 task common:generate:bindings",
    "check:wails-bindings": "node scripts/check-wails-bindings.mjs",
    "test:scripts": "node scripts/test-scripts.mjs",
    "test:api-release-scripts": "node scripts/api-release-scripts.test.mjs",
    "test:affected": "node scripts/test-affected.mjs",
    "test:desktop": "pnpm run prepare:desktop-release && pnpm run check:wails-bindings && pnpm run test:scripts -- desktop && go test -tags production,release_assets ./cmd/jftrade-desktop ./internal/desktop -count=1",
    "check:desktop": "go tool wails3 doctor && pnpm run test:desktop",
    "check:oss-license": "node scripts/check-oss-license.mjs",
    "check:test-names": "node scripts/check-test-names.mjs",
    "check:test-quality": "node scripts/report-go-test-quality.mjs",
    "report:test-quality": "node scripts/report-go-test-quality.mjs",
    "check:servercore-budget": "node scripts/check-servercore-budget.mjs",
    "check:assistant-budget": "node scripts/check-assistant-budget.mjs",
    "check:openapi-quality": "node scripts/check-openapi-quality.mjs",
    "check:web-api-boundary": "node scripts/check-web-api-boundary.mjs",
    "check:web-contract-index": "node scripts/check-web-contract-index.mjs",
    "check:web-contract-audit": "node scripts/check-web-contract-audit.mjs",
    "check:web-openapi-imports": "node scripts/check-web-openapi-imports.mjs",
    "check:web-bundle": "node scripts/report-web-bundle.mjs",
    "check:web-component-budget": "node scripts/check-web-component-budget.mjs",
    "check:web-file-length": "node scripts/check-web-file-length-budget.mjs",
    "test:test-policy": "go test ./scripts/go-test-quality -count=1 && pnpm run test:scripts -- policy",
    "test:preflight": "node scripts/run-test-layer.mjs preflight",
    "test:pr": "pnpm run test:preflight",
    "test:ci-local": "node scripts/run-test-layer.mjs ci-local",
    "test:main": "node scripts/run-test-layer.mjs main",
    "stage:docs": "node scripts/stage-docs.mjs",
    "check:pinets-compliance": "node scripts/check-pinets-compliance.mjs",
    "check:pinets-license": "node scripts/check-pinets-license.mjs",
    "typecheck": "pnpm run typecheck:web && pnpm run typecheck:web-contracts && pnpm run typecheck:pineworker"
  },
  "devDependencies": {
    "mermaid": "^11.16.1",
    "typescript": "^7.0.2",
    "vitepress": "2.0.0-alpha.18",
    "vue": "catalog:"
  }
}
