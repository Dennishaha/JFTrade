{
  "name": "@jftrade/web",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "docs:dev": "vitepress dev ../../docs --host 127.0.0.1 --port 3001",
    "docs:build": "vitepress build ../../docs",
    "build": "vite build",
    "test": "vitest run --fileParallelism --maxWorkers=4",
    "test:ci": "vitest run --fileParallelism --maxWorkers=2",
    "test:coverage": "vitest run --coverage --fileParallelism --maxWorkers=2",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:contracts": "tsc --noEmit -p tsconfig.type-tests.json"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tanstack/vue-query": "^5.101.4",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@wailsio/runtime": "3.0.0-beta.1",
    "lightweight-charts": "^5.2.0",
    "markdown-it": "^15.0.0",
    "mermaid": "^11.16.1",
    "monaco-editor": "0.56.0",
    "splitpanes": "^4.1.2",
    "vue": "catalog:",
    "vue-router": "^5.2.0",
    "vuetify": "4.1.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "8.2.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "catalog:",
    "vue-tsc": "^3.3.9"
  },
  "version": "0.0.0"
}
