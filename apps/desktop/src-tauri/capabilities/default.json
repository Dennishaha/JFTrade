{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the JFTrade desktop application",
  "local": true,
  "remote": {
    "urls": [
      "http://127.0.0.1:3003",
      "http://127.0.0.1:3003/*",
      "http://localhost:3003",
      "http://localhost:3003/*"
    ]
  },
  "windows": ["*"],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    "updater:default"
  ]
}
