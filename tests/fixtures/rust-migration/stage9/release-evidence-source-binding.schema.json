{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jftrade.local/schemas/release-evidence-source-binding.v1.json",
  "title": "JFTrade immutable raw release evidence source binding",
  "description": "Detached provenance for a raw evidence artifact accepted by the trusted intake workflow. Reports remain byte-identical.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "sourceRepository", "binding"],
  "properties": {
    "$schema": { "const": "./release-evidence-source-binding.schema.json" },
    "schemaVersion": { "const": "jftrade.release-evidence-source-binding.v1" },
    "sourceRepository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "binding": { "$ref": "#/$defs/binding" }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "releaseRef", "ref", "commitSha", "workflow", "runId", "attempt", "artifact"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "releaseRef": { "type": "string", "pattern": "^refs/(?:heads|tags)/(?!.*\\.\\.)[A-Za-z0-9._/-]+$" },
        "ref": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$" },
        "commitSha": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
        "workflow": { "const": "desktop-release-evidence-source.yml" },
        "runId": { "$ref": "#/$defs/safePositiveInteger" },
        "attempt": { "$ref": "#/$defs/safePositiveInteger" },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id", "digest"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "id": { "$ref": "#/$defs/safePositiveInteger" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "safePositiveInteger": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990|9007199254740991)$"
        }
      ]
    }
  }
}
