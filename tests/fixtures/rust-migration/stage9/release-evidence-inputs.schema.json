{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jftrade.local/schemas/release-evidence-inputs.v2.json",
  "title": "JFTrade externally supplied release qualification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "repository",
    "releaseRef",
    "ref",
    "commitSha",
    "workflow",
    "runId",
    "attempt",
    "artifact",
    "sourceBinding",
    "evidence"
  ],
  "properties": {
    "$schema": { "const": "./release-evidence-inputs.schema.json" },
    "schemaVersion": { "const": "jftrade.release-evidence-inputs.v2" },
    "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "releaseRef": { "type": "string", "pattern": "^refs/(?:heads|tags)/(?!.*\\.\\.)[A-Za-z0-9._/-]+$" },
    "ref": { "type": "string", "pattern": "^refs/(?:heads|tags)/(?!.*\\.\\.)[A-Za-z0-9._/-]+$" },
    "commitSha": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "workflow": { "enum": ["desktop-release-evidence.yml"] },
    "runId": { "$ref": "#/$defs/safePositiveInteger" },
    "attempt": { "$ref": "#/$defs/safePositiveInteger" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "sourceBinding": { "$ref": "#/$defs/binding" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed-updater-inputs",
        "sbom-provenance-inputs",
        "rollback-artifact-pair",
        "backup-restore-drill",
        "security-review-inputs"
      ],
      "properties": {
        "signed-updater-inputs": { "$ref": "#/$defs/evidence" },
        "sbom-provenance-inputs": { "$ref": "#/$defs/evidence" },
        "rollback-artifact-pair": { "$ref": "#/$defs/evidence" },
        "backup-restore-drill": { "$ref": "#/$defs/evidence" },
        "security-review-inputs": { "$ref": "#/$defs/evidence" }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "files"],
      "properties": {
        "kind": {
          "enum": [
            "signed-updater",
            "sbom-provenance",
            "rollback-artifact",
            "backup-restore",
            "security-review"
          ]
        },
        "status": { "const": "passed" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceFile" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id", "digest"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "id": { "$ref": "#/$defs/safePositiveInteger" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "releaseRef", "ref", "commitSha", "workflow", "runId", "attempt", "artifact"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "releaseRef": { "type": "string", "pattern": "^refs/(?:heads|tags)/(?!.*\\.\\.)[A-Za-z0-9._/-]+$" },
        "ref": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$" },
        "commitSha": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
        "workflow": { "enum": ["desktop-release-evidence-intake.yml", "desktop-release-evidence-source.yml"] },
        "runId": { "$ref": "#/$defs/safePositiveInteger" },
        "attempt": { "$ref": "#/$defs/safePositiveInteger" },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "evidenceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size", "kind", "schemaVersion"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "kind": {
          "enum": [
            "signed-updater",
            "sbom-provenance",
            "rollback-artifact",
            "backup-restore",
            "security-review"
          ]
        },
        "schemaVersion": {
          "enum": [
            "jftrade.release.signed-updater.v2",
            "jftrade.tauri-signed-updater.v1",
            "jftrade.release.sbom-provenance.v2",
            "jftrade.sbom-provenance-check.v1",
            "jftrade.release.rollback-artifact.v2",
            "jftrade.rollback-artifact.v1",
            "jftrade.release.backup-restore.v2",
            "jftrade.backup-restore-drill.v1",
            "jftrade.release.security-review.v2",
            "jftrade.security-review-signoff.v1"
          ]
        }
      }
    },
    "safePositiveInteger": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990|9007199254740991)$"
        }
      ]
    }
  }
}
