{
  "version": "stage9.market-data-quote-read.v1",
  "cases": [
    {
      "name": "subscriptions-empty",
      "method": "GET",
      "requestPath": "/api/v1/market-data/subscriptions",
      "expectedStatus": 200,
      "data": {
        "brokerState": {
          "desiredCount": 0,
          "entries": [],
          "ownActiveCount": 0,
          "pendingReleaseCount": 0,
          "remainQuota": null,
          "totalUsedQuota": null
        },
        "desiredCount": 0,
        "entries": [],
        "ownActiveCount": 0,
        "pendingReleaseCount": 0,
        "quota": {
          "byMarket": [],
          "totalLimit": null,
          "totalRemaining": null,
          "totalUsed": 0
        },
        "remainQuota": null,
        "totalActiveSubscriptions": 0,
        "totalUsedQuota": null
      }
    },
    {
      "name": "securities-ready",
      "method": "GET",
      "requestPath": "/api/v1/market-data/securities/US/AAPL",
      "expectedStatus": 200,
      "data": {
        "lotSize": 1,
        "name": "Fixture Apple",
        "symbol": "US.AAPL"
      }
    },
    {
      "name": "securities-cn-qualified-normalizes-to-leaf",
      "method": "GET",
      "requestPath": "/api/v1/market-data/securities/CN/SH.600519",
      "expectedStatus": 200,
      "data": {
        "lotSize": 100,
        "name": "Fixture Moutai",
        "symbol": "SH.600519"
      }
    },
    {
      "name": "securities-provider-failure",
      "method": "GET",
      "requestPath": "/api/v1/market-data/securities/US/FAIL",
      "expectedStatus": 502,
      "errorCode": "MARKET_SECURITY_DETAILS_FAILED",
      "errorMessage": "fixture security unavailable"
    },
    {
      "name": "snapshots-ready",
      "method": "GET",
      "requestPath": "/api/v1/market-data/snapshots/US/AAPL?refresh=true",
      "expectedStatus": 200,
      "data": {
        "meta": {
          "fromCache": false,
          "instrumentId": "US.AAPL",
          "resolvedAt": "fixture-time",
          "source": "fixture-quote"
        },
        "request": {
          "instrumentId": "US.AAPL",
          "market": "US",
          "symbol": "AAPL"
        },
        "snapshot": {
          "ask": "101.3",
          "at": "2026-08-22T13:30:00Z",
          "bid": "101.2",
          "extended": {
            "afterMarket": null,
            "overnight": null,
            "preMarket": null
          },
          "extendedHours": false,
          "highPrice": "102",
          "lastClosePrice": "100.5",
          "lowPrice": "99",
          "observedAt": "fixture-time",
          "openPrice": "100",
          "previousClosePrice": "100.5",
          "price": "101.25",
          "session": "regular",
          "turnover": "101250",
          "volume": "1000"
        }
      }
    },
    {
      "name": "snapshots-invalid-refresh",
      "method": "GET",
      "requestPath": "/api/v1/market-data/snapshots/US/AAPL?refresh=maybe",
      "expectedStatus": 400,
      "errorCode": "BAD_REQUEST",
      "errorMessage": "invalid refresh query"
    },
    {
      "name": "snapshots-capability-unsupported",
      "method": "GET",
      "requestPath": "/api/v1/market-data/snapshots/US/AAPL",
      "expectedStatus": 409,
      "errorCode": "MARKET_DATA_CAPABILITY_UNSUPPORTED",
      "errorMessage": "market-data capability is unsupported: active provider \"fixture-quote\" does not support snapshots"
    },
    {
      "name": "snapshots-provider-warming-retry",
      "method": "GET",
      "requestPath": "/api/v1/market-data/snapshots/SH/600519",
      "expectedStatus": 503,
      "headers": {
        "Retry-After": "1"
      },
      "errorCode": "MARKET_DATA_PROVIDER_WARMING",
      "errorMessage": "行情服务正在预热，请稍后重试"
    },
    {
      "name": "candles-ready-with-range-and-sessions",
      "method": "GET",
      "requestPath": "/api/v1/market-data/candles/US/AAPL?period=5m\u0026limit=2\u0026fromTime=2026-08-01T00:00:00Z\u0026toTime=2026-08-02T00:00:00Z\u0026sessions=regular\u0026sessions=extended",
      "expectedStatus": 200,
      "data": {
        "candles": [
          {
            "at": "2026-08-01T13:30:00Z",
            "close": "101.0",
            "open": "100.0"
          }
        ],
        "pagination": {
          "hasMore": false
        },
        "source": "fixture-candles"
      }
    },
