{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jftrade.local/schemas/post-release-binding.v1.json",
  "title": "JFTrade published release binding",
  "description": "Immutable provenance shared by every independently observed post-release smoke report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseTag",
    "releaseRef",
    "commitSha",
    "releaseRun",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": "jftrade.post-release-binding.v1" },
    "releaseTag": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    },
    "releaseRef": {
      "type": "string",
      "pattern": "^refs/tags/v\\d+\\.\\d+\\.\\d+$"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "releaseRun": { "$ref": "#/$defs/releaseRun" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "releaseRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attempt", "workflow", "ref", "commitSha"],
      "properties": {
        "id": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string", "pattern": "^[1-9][0-9]*$" }
          ]
        },
        "attempt": { "type": "integer", "minimum": 1 },
        "workflow": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "pattern": "^refs/tags/v\\d+\\.\\d+\\.\\d+$" },
        "commitSha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
