    {
      "name": "price-success",
      "method": "POST",
      "requestPath": "/api/v1/alerts/price?brokerId=futu\u0026accountId=acct-1",
      "body": "{\"symbol\":\"US.AAPL\",\"price\":190.5,\"enabled\":true}",
      "featureId": "alerts.price.set",
      "action": "set",
      "portMode": "success",
      "expected": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "envelope": {
          "data": {
            "entries": [
              {
                "accepted": true,
                "featureId": "alerts.price.set",
                "operation": "set"
              }
            ],
            "provider": {
              "asOf": "2026-08-22T04:00:00Z",
              "brokerId": "futu",
              "capability": "available",
              "featureId": "alerts.price.set",
              "resolvedAt": "2026-08-22T04:00:00Z",
              "securityFirm": "Futu/Moomoo via OpenD",
              "selectionReason": "explicit_broker"
            }
          },
          "ok": true,
          "timestamp": "2026-08-22T04:00:00Z"
        }
      },
      "calls": {
        "apply": 1,
        "action": {
          "accountId": "acct-1",
          "action": "set",
          "brokerId": "futu",
          "featureId": "alerts.price.set",
          "payload": {
            "enabled": true,
            "price": 190.5,
            "symbol": "US.AAPL"
          }
        },
        "payloadState": "object"
      }
    },
