{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jftrade.local/schemas/migration-manifest.v1.json",
  "title": "JFTrade migration verification manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "status", "source", "target", "components", "releaseVerification"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "jftrade.migration-manifest.v1" },
    "status": { "enum": ["synthetic_verified_release_unverified", "release_qualified"] },
    "source": {
      "type": "object",
      "required": ["release", "commit", "upgradeBaselines", "checksumManifestSha256", "packageDigests"],
      "properties": {
        "release": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "upgradeBaselines": { "type": "string", "minLength": 1 },
        "checksumManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "packageDigests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "kind", "name", "sha256"],
            "properties": {
              "platform": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["release"],
      "properties": {
        "release": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "releaseVerification": {
      "type": "object",
      "required": ["status", "requiredEvidence", "platforms", "runner", "receipt", "receiptDigest", "verifiedAt"],
      "properties": {
        "status": { "enum": ["not_verified", "passed"] },
        "requiredEvidence": { "type": "array", "items": { "type": "string" } },
        "platforms": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "runner": { "type": ["string", "null"] },
        "receipt": { "type": ["string", "null"] },
        "receiptDigest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "verifiedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "object",
      "required": ["schemaVersion", "sha256"],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 0 },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component", "fromVersion", "toVersion", "precondition", "postcondition",
        "invariants", "backup", "restore", "rollback", "idempotency", "failureRecovery", "verification"
      ],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "fromVersion": { "type": "integer", "minimum": 0 },
        "toVersion": { "type": "integer", "minimum": 1 },
        "precondition": { "$ref": "#/$defs/fingerprint" },
        "postcondition": { "$ref": "#/$defs/fingerprint" },
        "invariants": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "backup": {
          "type": "object",
          "required": ["required", "status", "evidence"],
          "properties": {
            "required": { "type": "boolean" },
            "status": { "enum": ["passed", "not_verified"] },
            "evidence": { "type": "array", "items": { "type": "string" } }
          }
        },
        "restore": {
          "type": "object",
          "required": ["required", "status", "evidence"],
          "properties": {
            "required": { "type": "boolean" },
            "status": { "enum": ["passed", "not_verified"] },
            "evidence": { "type": "array", "items": { "type": "string" } }
          }
        },
        "rollback": {
          "type": "object",
          "required": ["required", "supported", "status", "evidence"],
          "properties": {
            "required": { "type": "boolean" },
            "supported": { "type": "boolean" },
            "status": { "enum": ["passed", "not_verified"] },
            "evidence": { "type": "array", "items": { "type": "string" } }
          }
        },
        "idempotency": {
          "type": "object",
          "required": ["required", "status", "evidence"],
          "properties": {
            "required": { "type": "boolean" },
            "status": { "enum": ["passed", "not_verified"] },
            "evidence": { "type": "array", "items": { "type": "string" } }
          }
        },
        "failureRecovery": {
          "type": "object",
          "required": ["status", "evidence"],
          "properties": {
            "status": { "enum": ["passed", "not_verified"] },
            "evidence": { "type": "array", "items": { "type": "string" } }
          }
        },
        "verification": {
          "type": "object",
          "required": ["scope", "status", "test", "platforms", "runner", "receipt", "receiptDigest", "verifiedAt"],
          "properties": {
            "scope": { "enum": ["synthetic", "release"] },
            "status": { "enum": ["passed", "not_verified"] },
            "test": { "type": "string", "minLength": 1 },
            "platforms": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "runner": { "type": "string", "minLength": 1 },
            "receipt": { "type": ["string", "null"] },
            "receiptDigest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
            "verifiedAt": { "type": ["string", "null"], "format": "date-time" }
          }
        }
      }
    }
  }
}
