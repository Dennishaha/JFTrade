{
  "version": "stage9.market-data-news-actions-read.v1",
  "cases": [
    {
      "name": "news-omitted-limit-nullable-entries",
      "method": "GET",
      "requestPath": "/api/v1/market-data/news/US/AAPL",
      "expectedStatus": 200,
      "data": {
        "market": "US",
        "symbol": "AAPL",
        "instrumentId": "US.AAPL",
        "entries": [
          {
            "title": "Fixture headline",
            "link": "https://example.test/news",
            "publisher": null,
            "publishedAt": "2026-08-10T13:30:00Z",
            "summary": null
          },
          {
            "title": null,
            "link": null,
            "publisher": null,
            "publishedAt": null,
            "summary": null
          }
        ],
        "source": "fixture-news"
      },
      "providerCall": {
        "operation": "news",
        "market": "US",
        "symbol": "AAPL",
        "limit": 10
      }
    },
    {
      "name": "news-explicit-zero-rejected",
      "method": "GET",
      "requestPath": "/api/v1/market-data/news/US/AAPL?limit=0",
      "expectedStatus": 400,
      "errorCode": "BAD_REQUEST",
      "errorMessage": "limit must be between 1 and 50"
    },
    {
      "name": "news-malformed-limit-rejected",
      "method": "GET",
      "requestPath": "/api/v1/market-data/news/US/AAPL?limit=abc",
      "expectedStatus": 400,
      "errorCode": "BAD_REQUEST",
      "errorMessage": "limit must be an integer"
    },
    {
      "name": "news-over-limit-rejected",
      "method": "GET",
      "requestPath": "/api/v1/market-data/news/US/AAPL?limit=51",
      "expectedStatus": 400,
      "errorCode": "BAD_REQUEST",
      "errorMessage": "limit must be between 1 and 50"
    },
    {
      "name": "news-empty-entries",
      "method": "GET",
