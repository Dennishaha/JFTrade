      "name": "version-invalid-id-escape",
      "method": "GET",
      "path": "/api/v1/strategy-definitions/%ZZ/versions/0.1.0",
      "expectedStatus": 400,
      "errorCode": "BAD_REQUEST",
      "errorMessage": "invalid definition version"
    },
    {
      "name": "version-invalid-version-escape",
      "method": "GET",
      "path": "/api/v1/strategy-definitions/fixture-current/versions/%ZZ",
      "expectedStatus": 400,
