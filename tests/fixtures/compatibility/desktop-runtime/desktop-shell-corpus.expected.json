      },
      {
        "role": "marketdata-sidecar",
        "action": "start-failed"
      },
      {
        "role": "marketdata-sidecar",
        "action": "shutdown"
      },
      {
        "role": "pine-worker",
        "action": "shutdown"
      },
      {
        "role": "engine",
        "action": "shutdown"
      }
    ]
