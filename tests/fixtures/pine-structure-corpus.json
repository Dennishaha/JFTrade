    "id": "parameterized-trend-entry",
    "dimensions": ["input", "indicators", "technical-condition", "entry", "log"],
    "source": "//@version=6\nstrategy(\"Shared Trend Entry\", overlay=true)\nfast_length = input.int(9, \"Fast Length\")\nfast = ta.ema(close, 9)\nslow = ta.sma(close, 21)\nif ta.crossover(fast, slow)\n    log.info(\"trend crossed\")\n    strategy.entry(\"Long\", strategy.long, qty=1)",
    "expectedStatementKinds": {
      "let": 3,
      "if": 1,
      "log": 1,
      "order": 1
    },
    "expectedVisualBlockKinds": {
      "strategyInput": 1,
      "getTechnicalIndicator": 2,
      "technicalIndicatorCondition": 1,
      "log": 1,
      "placeOrder": 1
    },
    "expectedVisualSemantics": [
      "getTechnicalIndicator:movingAverage:EMA",
      "getTechnicalIndicator:movingAverage:SMA",
      "log",
      "placeOrder:entry",
      "strategyInput:int",
      "technicalIndicatorCondition:pattern:goldenCross"
    ],
    "expectedBranches": {
      "true": 1,
      "false": 0
    },
    "expectedBranchTargets": {
      "true:log": 1
    },
    "expectedTradeSemantics": [
      "order:entry:Long:buy:shares:1:limit=false:stop=false:immediate=false"
    ],
    "expectedMaxIfDepth": 1
  },
