      "if": 2,
      "order": 1,
      "notify": 1,
      "cancel": 1
    },
    "expectedVisualBlockKinds": {
      "timeFilter": 1,
      "sessionFilter": 1,
      "placeOrder": 2,
      "notify": 1
    },
    "expectedVisualSemantics": [
      "notify",
      "placeOrder:cancel",
      "placeOrder:order",
      "sessionFilter:market",
      "timeFilter:between"
    ],
    "expectedBranches": {
      "true": 2,
      "false": 2
