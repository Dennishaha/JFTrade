{
  "version": 4,
  "sourceRoots": ["apps", "workers", "crates"],
  "sourceExtensions": [".js", ".mjs", ".py", ".rs", ".ts", ".tsx", ".vue"],
  "ignoredSourcePaths": [],
  "modules": [
    {
      "id": "rust",
      "paths": [
        "Cargo.toml",
        "Cargo.lock",
        "deny.toml",
        "rust-toolchain.toml",
        "crates",
        "tests/fixtures/compatibility"
      ],
      "entrypoints": ["crates/jftrade-engine/src/bin/jftrade-api-rust.rs"],
      "affectedTests": ["pnpm run check:rust"],
      "quickTests": ["pnpm run check:rust:architecture"]
    },
    {
      "id": "desktop",
      "paths": [
        "apps/desktop/src-tauri",
        "runtime-assets",
        "scripts/release",
        "tests/fixtures/release",
        ".github/workflows/desktop-release.yml",
        ".github/workflows/desktop-release-evidence-source.yml",
        ".github/workflows/desktop-release-evidence-intake.yml",
        ".github/workflows/desktop-release-evidence-payload.yml",
        ".github/workflows/desktop-release-evidence.yml",
        ".github/workflows/desktop-release-qualification.yml",
        ".github/workflows/desktop-post-release-validation.yml"
      ],
      "entrypoints": ["apps/desktop/src-tauri/src/main.rs"],
      "affectedTests": ["pnpm run check:desktop"]
    },
    {
      "id": "contracts",
      "paths": ["contracts", "proto"],
      "entrypoints": ["contracts/openapi/openapi.json"],
      "affectedTests": ["pnpm run check:contracts"],
      "generatedPaths": ["apps/web/src/generated/openapi.ts", "docs/reference/generated"]
    },
    {
      "id": "web",
      "paths": ["apps/web"],
      "entrypoints": ["apps/web/src/pages"],
      "affectedTests": ["pnpm run check:web"]
    },
    {
      "id": "pineworker",
      "paths": ["workers/pineworker"],
      "entrypoints": ["workers/pineworker/src/main.ts"],
      "affectedTests": ["pnpm run check:pine"]
    },
    {
      "id": "marketdata-sidecar",
      "paths": ["workers/marketdata-sidecar"],
      "entrypoints": ["workers/marketdata-sidecar/src/marketdata_sidecar/main.py"],
      "affectedTests": ["pnpm run check:python"]
    }
  ],
  "requiredInstructionFiles": [
    "AGENTS.md",
    "CLAUDE.md",
    "docs/architecture/quality-gates.md",
    "docs/architecture/release-qualification.md",
    "apps/web/AGENTS.md",
    "workers/AGENTS.md"
  ],
  "legacyPaths": ["pkg/jftradeapi", "pkg/adk", "pkg/jftsettings"]
}
