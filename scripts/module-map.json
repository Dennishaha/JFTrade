{
  "version": 3,
  "sourceRoots": ["apps", "workers", "crates"],
  "sourceExtensions": [".js", ".mjs", ".py", ".rs", ".ts", ".tsx", ".vue"],
  "ignoredSourcePaths": [],
  "modules": [
    {
      "id": "rust-foundation",
      "paths": ["Cargo.toml", "Cargo.lock", "deny.toml", "rust-toolchain.toml", "crates", "scripts/rust-migration", "tests/fixtures/rust-migration"],
      "entrypoints": ["crates/jftrade-engine/src/bin/jftrade-api-rust.rs"],
      "affectedTests": [
        "pnpm run check:rust:layout",
        "node --test scripts/rust-migration/check-stage9-closeout.test.mjs scripts/rust-migration/stage9-route-ownership.test.mjs",
        "pnpm run test:rust:stage9:route-coverage"
      ],
      "quickTests": ["pnpm run check:rust:layout"]
    },
    {
      "id": "desktop",
      "paths": [
        "apps/desktop/src-tauri",
        "runtime-assets",
        "scripts/dev-tauri-frontend.mjs",
        "scripts/lib/desktop-release-inputs.mjs",
        "scripts/lib/tauri-runtime.mjs",
        "scripts/prepare-tauri-release-runtime.mjs",
        "scripts/run-tauri.mjs",
        "scripts/smoke-tauri-release.mjs"
      ],
      "entrypoints": ["apps/desktop/src-tauri/src/main.rs"],
      "affectedTests": ["pnpm run test:tauri-release-runtime"]
    },
    {
      "id": "contracts",
      "paths": ["contracts", "proto"],
      "entrypoints": ["contracts/openapi/openapi.json"],
      "affectedTests": ["pnpm run check:generated"],
      "generatedPaths": ["apps/web/src/generated/openapi.ts", "docs/reference/generated"]
    },
    {
      "id": "web",
      "paths": ["apps/web"],
      "entrypoints": ["apps/web/src/pages"],
      "affectedTests": []
    },
    {
      "id": "pineworker",
      "paths": ["workers/pineworker"],
      "entrypoints": ["workers/pineworker/src/main.ts"],
      "affectedTests": [
        "pnpm --filter @jftrade/pineworker run test",
        "pnpm --filter @jftrade/pineworker run typecheck"
      ]
    },
    {
      "id": "marketdata-sidecar",
      "paths": ["workers/marketdata-sidecar"],
      "entrypoints": ["workers/marketdata-sidecar/src/marketdata_sidecar/main.py"],
      "affectedTests": ["workers/marketdata-sidecar/.venv/bin/python -m pytest workers/marketdata-sidecar/tests"]
    }
  ],
  "requiredInstructionFiles": [
    "AGENTS.md",
    "CLAUDE.md",
    "docs/architecture/rust-migration-execution-playbook.md",
    "apps/web/AGENTS.md",
    "workers/AGENTS.md"
  ],
  "legacyPaths": ["pkg/jftradeapi", "pkg/adk", "pkg/jftsettings"]
}
